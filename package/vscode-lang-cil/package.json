{
	"name": "vscode-lang-cil",
	"version": "0.0.1",
	"description": "Rich syntax highlighting for .NET's Common Intermediate Language",
	"displayName": "Common Intermediate Language",
	"publisher": "AFatNiBBa",
	"license": "MIT",
	"browser": "./dist/index.js",
	"icon": "img/logo.png",
	"scripts": {
		"build": "vite build",
		"watch": "npm run build -- --watch",
		"vsix": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"vsce": "^1.87.0"
	},
	"dependencies": {
		"@seanalunni/tree-sitter-cil": "^1.2.0",
		"vscode-tree-sitter": "^0.0.1",
		"web-tree-sitter": "^0.27.0"
	},
	"activationEvents": [
		"onLanguage:cil"
	],
	"contributes": {
		"languages": [
			{
				"id": "cil",
				"extensions": [
					".il",
					".cil",
					".msil"
				]
			}
		],
		"semanticTokenModifiers": [
			{
				"id": "escape",
				"description": "Escape sequence in a string"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "cil",
				"scopes": {
					"string.escape": [ "constant.character.escape" ]
				}
			}
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AFatNiBBa/vscode-tree-sitter.git"
	},
	"categories": [
		"Programming Languages"
	],
	"engines": {
		"vscode": "^1.100.0"
	}
}